# EchoAssist dashboard — environment

# Base URL of the EchoAssist FastAPI backend (no trailing slash).
# The WebSocket URL is derived from this (http -> ws).
VITE_API_BASE_URL=http://localhost:8000

# "true"  -> serve the dashboard from the in-browser mock backend (MSW), fully offline.
# "false" -> talk to the real backend at VITE_API_BASE_URL.
# Unset    -> mocks ON during `vite dev`, OFF for production builds.
VITE_USE_MOCKS=true
