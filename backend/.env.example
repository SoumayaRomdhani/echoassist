# EchoAssist backend configuration (ARCHITECTURE.md §5).
# Copy to `.env` and fill in. Switching a provider here changes NO code.
#   cp .env.example .env

# --- Active provider + domain selection ---
STT_PROVIDER=whisper_local        # whisper_local | deepgram
LLM_PROVIDER=ollama               # ollama | gemini | groq | claude   (ollama = open-source default)
                                  # No GPU? Easiest start: set LLM_PROVIDER=gemini and fill GEMINI_API_KEY below.
                                  # Free + fast + generous quota: set LLM_PROVIDER=groq and fill GROQ_API_KEY below.
TTS_PROVIDER=kokoro               # kokoro | deepgram | cartesia | elevenlabs
DOMAIN=screening                  # screening | hr | helpdesk | credit_transfer

# --- STT: faster-whisper (open-source default) ---
WHISPER_MODEL=base                # tiny | base | small | medium | large-v3 (large-v3 = production target)
WHISPER_DEVICE=auto               # auto | cpu | cuda   (set cpu if <4GB VRAM)
WHISPER_COMPUTE_TYPE=int8         # int8 | int8_float16 | float16 | float32
# WHISPER_LANGUAGE=en             # leave unset to auto-detect (FR/EN)
WHISPER_BEAM_SIZE=5

# --- STT: Deepgram (paid drop-in — set STT_PROVIDER=deepgram; key at https://console.deepgram.com) ---
# Bilingual EN/FR: use nova-3 + DEEPGRAM_LANGUAGE=multi so it transcribes the caller's
# language and follows a mid-call switch (nova-2 does NOT code-switch in real time).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3            # nova-3 = real-time FR<->EN code-switching (with =multi below) | nova-2
DEEPGRAM_LANGUAGE=multi         # multi = auto FR/EN per utterance. Pin en|fr only for a single-language call.

# --- LLM: Gemini (default — get a free key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- LLM: Ollama (fully local alternative — `ollama pull qwen3`) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3

# --- LLM: Groq (free + fast cloud — set LLM_PROVIDER=groq; free key at https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile  # reliable tool calling (needed by RAG + notes) | llama-3.1-8b-instant = faster but flaky tool calls

# --- TTS: Kokoro (open-source default) ---
# Language-aware: speaks with the DEFAULT (English) voice and auto-switches to the FR voice
# per reply when the text is French. Do NOT set KOKORO_LANG_CODE=f to get French — that forces
# EVERYTHING (incl. the English disclosure) into French. Keep the default English; FR handles French.
KOKORO_LANG_CODE=a                # default/English pipeline: a=American, b=British
KOKORO_VOICE=af_heart             # default/English voice
KOKORO_LANG_CODE_FR=f             # French pipeline (espeak-ng 'fr'); used only on French replies
KOKORO_VOICE_FR=ff_siwis          # Kokoro's French voice
KOKORO_SPEED=1.0

# --- TTS: Deepgram Aura (paid drop-in — set TTS_PROVIDER=deepgram; key at https://console.deepgram.com) ---
# Separate key from STT's DEEPGRAM_API_KEY so TTS credits stay on their own line
# (falls back to DEEPGRAM_API_KEY if left blank). The voice is the model — no voice id.
# An Aura voice speaks one language (…-en vs …-fr), so a French voice is picked per reply when
# the caller speaks French. Set DEEPGRAM_TTS_MODEL_FR blank to keep every reply on the EN voice.
DEEPGRAM_TTS_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en     # default/English voice (e.g. aura-2-asteria-en)
DEEPGRAM_TTS_MODEL_FR=aura-2-agathe-fr  # French voice, used per-reply on French turns (or aura-2-hector-fr)
DEEPGRAM_TTS_SAMPLE_RATE=24000          # 8000 | 16000 | 24000 | 32000 | 48000 (linear16)

# --- TTS: Cartesia (paid drop-in — set TTS_PROVIDER=cartesia; key at https://play.cartesia.ai) ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=                # required: pick a voice id in the Cartesia playground
CARTESIA_MODEL=sonic-2
CARTESIA_SAMPLE_RATE=24000        # 8000 | 16000 | 22050 | 24000 | 44100 | 48000
# CARTESIA_LANGUAGE=fr            # leave UNSET so sonic-2 auto-detects EN/FR per reply (one voice, both
                                  # languages). Setting it pins every reply to that language — e.g. fr | en.

# --- TTS: ElevenLabs (paid drop-in — set TTS_PROVIDER=elevenlabs; key at https://elevenlabs.io) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=              # required: pick a voice id in the ElevenLabs library
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_SAMPLE_RATE=24000      # 8000 | 16000 | 22050 | 24000 | 32000 | 44100 | 48000

# --- TTS streaming / latency (domain-agnostic; a domain YAML may override under `tts_stream:`) ---
TTS_STREAM_EARLY_CHUNKING=true     # flush text to TTS on commas/word-count (low TTFA); false = whole sentences
TTS_STREAM_MIN_WORDS=3             # don't flush a soft/stalled chunk shorter than this
TTS_STREAM_MAX_WORDS=10            # force a flush after this many words with no punctuation
TTS_STREAM_MAX_DELAY_MS=400        # flush a >= MIN_WORDS chunk if the text stalls this long
# TTS_LOCAL_SMOOTHING=false        # coalesce each chunk's audio for gap-free local playback (raises TTFA)

# --- Perceived-latency filler (professional, pre-synthesized; a domain YAML may set `filler:`) ---
FILLER_ENABLED=true                # cover a SLOW grounded turn with a short cached acknowledgement
FILLER_DELAY_MS=800                # only play it if no real audio is ready within this long
FILLER_ONLY_FOR_RAG=true           # never fill slot answers or meta replies
# FILLER_PHRASES=Let me check that. | One moment while I check. | I'll look that up.  # rotated pool; "|" or ";" separated (default: a built-in pool)
# FILLER_PHRASES_FR=Je vérifie ça. | Un instant, je vérifie. | Laissez-moi vérifier.  # French pool, played on French turns (default: a built-in pool)

# --- RAG: embeddings / reranker / vector store (Sprint 2) ---
EMBEDDINGS_PROVIDER=fastembed     # fastembed | bge_m3
RERANKER_PROVIDER=fastembed       # fastembed | bge | voyage | none
# Multilingual (FR/EN) defaults. English-only (lighter) alternatives in comments.
FASTEMBED_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # en-only: BAAI/bge-small-en-v1.5
FASTEMBED_SPARSE_MODEL=Qdrant/bm25
FASTEMBED_RERANK_MODEL=BAAI/bge-reranker-base                                       # en-only: Xenova/ms-marco-MiniLM-L-6-v2
# Reranker: Voyage (paid drop-in — set RERANKER_PROVIDER=voyage; key at https://dashboard.voyageai.com).
# Offloads the CPU-heavy rerank to the cloud (big speedup on a small box). NOTE: re-tune
# GROUNDING_MIN_CONFIDENCE below — 0.05 is calibrated for the FastEmbed reranker's scale.
VOYAGE_API_KEY=
VOYAGE_RERANK_MODEL=rerank-2.5    # rerank-2.5 | rerank-2.5-lite | rerank-2 (all multilingual)
QDRANT_URL=http://localhost:6333  # server (docker compose up -d qdrant); or "local" for embedded on-disk (no Docker)
RAG_TOP_K=6
RAG_CANDIDATES=20
RRF_K=60
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# --- Conversation state (Sprint 3) ---
STATE_BACKEND=redis               # redis | memory  (memory = no Redis needed, not shared across processes)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=echoassist:call:

# --- Persistence (Sprint 4) ---
DATABASE_URL=postgresql+psycopg://echoassist:echoassist@localhost:5433/echoassist  # host 5433 (avoids a local 5432)
DEFAULT_CAMPAIGN=Screening — default campaign

# --- Guardrails (Sprint 5) ---
GROUNDING_MIN_CONFIDENCE=0.05      # min reranker confidence (0..1) to answer; below it, refuse (calibrated for FR)
REDACT_PII=true                   # mask emails/phone numbers before persistence

# --- Backend API (Sprint 6) ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*                 # comma-separated dashboard origins ("*" = any, dev only)
# API_AUTH_TOKEN=                  # shared secret → WS clients must send ?access_token=<this> (unset = open, dev only)

# --- Provider failover (Sprint 6) — graceful degradation, never silent ---
# LLM_FALLBACK_PROVIDER=ollama     # secondary LLM tried when the primary fails (quota/transport)

# --- Telephony: LiveKit + SIP (Sprint 8 Path B) — used by scripts/run_livekit.py ---
# LiveKit Cloud (https://cloud.livekit.io) or a self-hosted server. The same Transport
# over WebRTC/PSTN; nothing else in the pipeline changes. Leave unset to stay on the mic.
LIVEKIT_URL=                       # wss://<you>.livekit.cloud | ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=echoassist
LIVEKIT_IDENTITY=agent

# --- Observability (Sprint 6) — OpenTelemetry tracing ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=echoassist-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces  # export to a collector/Tempo
                                                               # (needs: pip install -e ".[observability-otlp]")
OTEL_CONSOLE_EXPORT=false          # print spans to stdout (noisy; debugging only)

# --- Generation / misc ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LOG_LEVEL=INFO
