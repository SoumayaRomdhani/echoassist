# EchoAssist backend configuration (ARCHITECTURE.md §5).
# Copy to `.env` and fill in. Switching a provider here changes NO code.
#   cp .env.example .env

# --- Active provider + domain selection ---
STT_PROVIDER=whisper_local        # whisper_local | deepgram
LLM_PROVIDER=ollama               # ollama | gemini | claude   (ollama = open-source default)
                                  # No GPU? Easiest start: set LLM_PROVIDER=gemini and fill GEMINI_API_KEY below.
TTS_PROVIDER=kokoro               # kokoro | cartesia | elevenlabs
DOMAIN=screening                  # screening | hr | helpdesk | credit_transfer

# --- STT: faster-whisper (open-source default) ---
WHISPER_MODEL=base                # tiny | base | small | medium | large-v3 (large-v3 = production target)
WHISPER_DEVICE=auto               # auto | cpu | cuda   (set cpu if <4GB VRAM)
WHISPER_COMPUTE_TYPE=int8         # int8 | int8_float16 | float16 | float32
# WHISPER_LANGUAGE=en             # leave unset to auto-detect (FR/EN)
WHISPER_BEAM_SIZE=5

# --- LLM: Gemini (default — get a free key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- LLM: Ollama (fully local alternative — `ollama pull qwen3`) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3

# --- TTS: Kokoro (open-source default) ---
KOKORO_LANG_CODE=a                # a=American English, b=British, f=French, ...
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# --- RAG: embeddings / reranker / vector store (Sprint 2) ---
EMBEDDINGS_PROVIDER=fastembed     # fastembed | bge_m3
RERANKER_PROVIDER=fastembed       # fastembed | bge | none
# Multilingual (FR/EN) defaults. English-only (lighter) alternatives in comments.
FASTEMBED_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # en-only: BAAI/bge-small-en-v1.5
FASTEMBED_SPARSE_MODEL=Qdrant/bm25
FASTEMBED_RERANK_MODEL=BAAI/bge-reranker-base                                       # en-only: Xenova/ms-marco-MiniLM-L-6-v2
QDRANT_URL=http://localhost:6333  # server (docker compose up -d qdrant); or "local" for embedded on-disk (no Docker)
RAG_TOP_K=6
RAG_CANDIDATES=20
RRF_K=60
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# --- Conversation state (Sprint 3) ---
STATE_BACKEND=redis               # redis | memory  (memory = no Redis needed, not shared across processes)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=echoassist:call:

# --- Persistence (Sprint 4) ---
DATABASE_URL=postgresql+psycopg://echoassist:echoassist@localhost:5433/echoassist  # host 5433 (avoids a local 5432)
DEFAULT_CAMPAIGN=Screening — default campaign

# --- Generation / misc ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LOG_LEVEL=INFO
