# EchoAssist backend configuration (ARCHITECTURE.md §5).
# Copy to `.env` and fill in. Switching a provider here changes NO code.
#   cp .env.example .env

# --- Active provider + domain selection ---
STT_PROVIDER=whisper_local        # whisper_local | deepgram
LLM_PROVIDER=ollama               # ollama | gemini | claude   (ollama = open-source default)
                                  # No GPU? Easiest start: set LLM_PROVIDER=gemini and fill GEMINI_API_KEY below.
TTS_PROVIDER=kokoro               # kokoro | cartesia | elevenlabs
DOMAIN=screening                  # screening | hr | helpdesk | credit_transfer

# --- STT: faster-whisper (open-source default) ---
WHISPER_MODEL=base                # tiny | base | small | medium | large-v3 (large-v3 = production target)
WHISPER_DEVICE=auto               # auto | cpu | cuda   (set cpu if <4GB VRAM)
WHISPER_COMPUTE_TYPE=int8         # int8 | int8_float16 | float16 | float32
# WHISPER_LANGUAGE=en             # leave unset to auto-detect (FR/EN)
WHISPER_BEAM_SIZE=5

# --- STT: Deepgram (paid drop-in — set STT_PROVIDER=deepgram; key at https://console.deepgram.com) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2             # nova-2 (broad multilingual) | nova-3 | ...
# DEEPGRAM_LANGUAGE=fr            # leave unset for Deepgram default; e.g. fr | en | multi

# --- LLM: Gemini (default — get a free key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- LLM: Ollama (fully local alternative — `ollama pull qwen3`) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3

# --- TTS: Kokoro (open-source default) ---
KOKORO_LANG_CODE=a                # a=American English, b=British, f=French, ...
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# --- TTS: Cartesia (paid drop-in — set TTS_PROVIDER=cartesia; key at https://play.cartesia.ai) ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=                # required: pick a voice id in the Cartesia playground
CARTESIA_MODEL=sonic-2
CARTESIA_SAMPLE_RATE=24000        # 8000 | 16000 | 22050 | 24000 | 44100 | 48000
# CARTESIA_LANGUAGE=fr            # leave unset for model default; e.g. fr | en

# --- TTS: ElevenLabs (paid drop-in — set TTS_PROVIDER=elevenlabs; key at https://elevenlabs.io) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=              # required: pick a voice id in the ElevenLabs library
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_SAMPLE_RATE=24000      # 8000 | 16000 | 22050 | 24000 | 32000 | 44100 | 48000

# --- RAG: embeddings / reranker / vector store (Sprint 2) ---
EMBEDDINGS_PROVIDER=fastembed     # fastembed | bge_m3
RERANKER_PROVIDER=fastembed       # fastembed | bge | none
# Multilingual (FR/EN) defaults. English-only (lighter) alternatives in comments.
FASTEMBED_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # en-only: BAAI/bge-small-en-v1.5
FASTEMBED_SPARSE_MODEL=Qdrant/bm25
FASTEMBED_RERANK_MODEL=BAAI/bge-reranker-base                                       # en-only: Xenova/ms-marco-MiniLM-L-6-v2
QDRANT_URL=http://localhost:6333  # server (docker compose up -d qdrant); or "local" for embedded on-disk (no Docker)
RAG_TOP_K=6
RAG_CANDIDATES=20
RRF_K=60
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# --- Conversation state (Sprint 3) ---
STATE_BACKEND=redis               # redis | memory  (memory = no Redis needed, not shared across processes)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=echoassist:call:

# --- Persistence (Sprint 4) ---
DATABASE_URL=postgresql+psycopg://echoassist:echoassist@localhost:5433/echoassist  # host 5433 (avoids a local 5432)
DEFAULT_CAMPAIGN=Screening — default campaign

# --- Guardrails (Sprint 5) ---
GROUNDING_MIN_CONFIDENCE=0.05      # min reranker confidence (0..1) to answer; below it, refuse (calibrated for FR)
REDACT_PII=true                   # mask emails/phone numbers before persistence

# --- Backend API (Sprint 6) ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*                 # comma-separated dashboard origins ("*" = any, dev only)
# API_AUTH_TOKEN=                  # shared secret → WS clients must send ?access_token=<this> (unset = open, dev only)

# --- Provider failover (Sprint 6) — graceful degradation, never silent ---
# LLM_FALLBACK_PROVIDER=ollama     # secondary LLM tried when the primary fails (quota/transport)

# --- Telephony: LiveKit + SIP (Sprint 8 Path B) — used by scripts/run_livekit.py ---
# LiveKit Cloud (https://cloud.livekit.io) or a self-hosted server. The same Transport
# over WebRTC/PSTN; nothing else in the pipeline changes. Leave unset to stay on the mic.
LIVEKIT_URL=                       # wss://<you>.livekit.cloud | ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=echoassist
LIVEKIT_IDENTITY=agent

# --- Observability (Sprint 6) — OpenTelemetry tracing ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=echoassist-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces  # export to a collector/Tempo
                                                               # (needs: pip install -e ".[observability-otlp]")
OTEL_CONSOLE_EXPORT=false          # print spans to stdout (noisy; debugging only)

# --- Generation / misc ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LOG_LEVEL=INFO
